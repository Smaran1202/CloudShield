# Copy this file to .env and fill in the values. Names only: never put real values here.
# A variable already set in the shell wins over this file.
# Where the results are stored. The default is sqlite:///cloudshield.db; for the demo use sqlite:///demo.db.
DATABASE_URL=
# The AWS profile a scan uses (the standard boto3 chain, read-only access). Never put keys here.
AWS_PROFILE=
# The region a scan covers when the request names none.
AWS_REGION=
# Optional. Lets CloudShield ask Gemini to explain a fix. Without it a fixed template is used.
GEMINI_API_KEY=
# The Gemini model used for fix explanations.
GEMINI_MODEL=
# Optional. A second Gemini model, tried when the first one fails.
GEMINI_FALLBACK_MODEL=
# Reserved. Nothing reads it yet. It is only recorded in the numbers report.
EMBEDDING_MODEL=
# How many Gemini calls the API makes in one hour at most (default 30).
AI_MAX_CALLS_PER_HOUR=
# The one web address the API accepts writes from (default http://localhost:5173).
FRONTEND_ORIGIN=
# Names of identities that belong to CloudShield itself, separated by commas. Never dismissed automatically.
CLOUDSHIELD_OWN_IDENTITIES=
# A Python that has Prowler installed, used by "Run full scan" in local mode.
PROWLER_PYTHON=
# A JSON list that starts Prowler when PROWLER_PYTHON is empty (default ["prowler"]).
PROWLER_COMMAND=
# local (default) or docker. docker runs the Prowler container.
PROWLER_MODE=
# Docker mode: the image. A pinned tag such as toniblyx/prowler:5.44.0 is more reproducible than latest.
PROWLER_DOCKER_IMAGE=
# Docker mode: the docker program, or its full path if it is not on the PATH of the server.
DOCKER_COMMAND=
# The Prowler services a run checks, separated by spaces (default s3 ec2 iam).
PROWLER_SERVICES=
# Seconds before a Prowler run is stopped (default 1800).
PROWLER_TIMEOUT_SECONDS=
# Where each Prowler run gets a temporary folder (default ./data). Keep it outside OneDrive for Docker.
CLOUDSHIELD_DATA_DIR=
# true keeps Prowler's raw output file after the import. Default false.
KEEP_RAW_OUTPUT=
