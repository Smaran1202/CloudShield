# Copy this file to .env and fill in the values. Names only: never put real values here.
# A variable already set in the shell wins over this file.
DATABASE_URL=
AWS_PROFILE=
AWS_REGION=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
EMBEDDING_MODEL=
AI_MAX_CALLS_PER_HOUR=
FRONTEND_ORIGIN=
CLOUDSHIELD_OWN_IDENTITIES=
PROWLER_PYTHON=
PROWLER_COMMAND=
# local (default) or docker. docker runs the Prowler container.
PROWLER_MODE=
# Docker mode: the image. A pinned tag such as toniblyx/prowler:5.44.0 is more reproducible than latest.
PROWLER_DOCKER_IMAGE=
# Docker mode: the docker program, or its full path if it is not on the PATH of the server.
DOCKER_COMMAND=
PROWLER_SERVICES=
PROWLER_TIMEOUT_SECONDS=
CLOUDSHIELD_DATA_DIR=
KEEP_RAW_OUTPUT=
